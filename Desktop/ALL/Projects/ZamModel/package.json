{
  "name": "zam-models-and-signatures",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace @zam/web",
    "dev:api": "npm run dev --workspace @zam/api",
    "build": "npm run build --workspace @zam/api && npm run build --workspace @zam/web",
    "typecheck": "npm run typecheck --workspace @zam/api && npm run typecheck --workspace @zam/web",
    "db:generate": "dotenv -e apps/api/.env -- prisma generate",
    "db:migrate": "dotenv -e apps/api/.env -- prisma migrate deploy",
    "db:seed": "dotenv -e apps/api/.env -- tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
